# Knowledge OS — local environment.
# Copy to `.env` before `docker compose up`. Every value has a working default
# in docker-compose.yml; this file documents the knobs.

# --- App ---
APP_ENV=local                # local | test | ci | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
VERSION=0.1.0
GIT_SHA=unknown

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3001
# Run `alembic upgrade head` automatically during API startup (non-fatal).
MIGRATIONS_ON_BOOT=true
READINESS_TIMEOUT_SECONDS=1.5

# --- PostgreSQL (metadata + lexical FTS, PD-002) ---
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge
POSTGRES_DB=knowledge
# Host port mapping only; containers use the service name `postgres`.
POSTGRES_PORT=5432
# Used by the API/worker/Alembic:
DATABASE_URL=postgresql+psycopg://knowledge:knowledge@localhost:5432/knowledge

# --- Redis (worker broker / cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (dense vector store, PD-002) ---
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# --- MinIO / S3 (document originals) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=knowledge-os
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MinIO official Docker images were withdrawn from Docker Hub/Quay in 2026.
# Override with your own trusted, pinned S3-compatible image if required.
# See infrastructure/docker/README.md and the M0-003 handoff (known issue).
# MINIO_IMAGE=elestio/minio@sha256:25348a257f1ece1b192f25f6cd9854618fa86422ac87b494b5d4e629c556d4bd

# --- SeaweedFS (PD-005, 2026-10-08) ---
# Optional external S3-compatible service (Apache-2.0). Adapter-only access:
# packages/storage/adapters/seaweedfs_s3.py (httpx, zero SDK import).
# Compose documents this as optional; one-command backend swap = change endpoint.
# Image unmodified (compose/env only); vendor guard + grep pin verifies no SDK.
SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=admin
SEAWEEDFS_SECRET_KEY=admin

# --- Web (Next.js) ---
# Host default 3001 (host :3000 is a common dev port and often occupied);
# keep overridable per host if 3001 is taken too.
WEB_PORT=3001
# Backend origin as seen from the web container (read by the /api/health proxy).
# docker compose: http://api:8000 ; local dev outside Docker: http://localhost:8000
API_BASE_URL=http://localhost:8000
# Set true behind TLS so the web auth cookies (kios_access/kios_refresh) get the
# Secure flag. Left false for the plain-HTTP local compose stack.
COOKIE_SECURE=false

# --- Auth (M1-001a/b) ---
# HS256 signing key for access/refresh JWTs. Must be set (>=32 bytes) and kept
# secret outside local/test; the API refuses the built-in dev default when
# APP_ENV is staging/production.
AUTH_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789

# --- Ingestion queue (M2-001c) ---
# Namespace for the Redis ingestion queue keys (default: <APP_ENV>:).
# Set a distinct value (e.g. "test:") so test runs never share a queue with a
# live worker.
INGEST_QUEUE_PREFIX=

# --- Chunking (TASK-M2-002) ---
# Chunking backend used by the worker.
#   llamaindex (default) -> llama_index.core SentenceSplitter (MIT),
#                           our deterministic tokenizer/sentence splitter injected;
#   builtin              -> the M2-001b whitespace chunker (opt-out / A-B).
# If llamaindex is selected but llama-index-core is missing from the image, the
# worker logs chunking_backend_fallback and uses the built-in chunker, so
# ingestion never hard-fails on an optional dependency.
CHUNKING_BACKEND=llamaindex

# --- Retrieval models (TASK-M3-002/M3-004) ---
# infinity serves bge-m3 (embeddings) + cross-encoder/ms-marco-MiniLM-L6-v2 (rerank) over an
# OpenAI/Jina-compatible HTTP API.
INFINITY_URL=http://localhost:7997
INFINITY_API_KEY=
# Optional exact HuggingFace revision of the served bge-m3; leave blank to use
# the adapter's model-identity default ("BAAI/bge-m3"). Set this in staging/
# production to pin the model revision (PD-002 version contract).
EMBEDDING_REVISION=
# Reranker model served by infinity (adapter default cross-encoder/ms-marco-MiniLM-L6-v2).
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- LLM Gateway / Low-RAM Cloud Routing (TASK-M4-001/M7-001) ---
# LiteLLM gateway base URL. To run with zero local RAM overhead on Contabo,
# point directly to OpenRouter or DeepSeek using the active cloud keys:
LITELLM_URL=https://openrouter.ai/api/v1
LITELLM_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

