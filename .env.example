# Knowledge OS: copy this file to `.env` and fill in the REQUIRED lines.
# Everything else already has a working default in docker-compose.yml.

# --- REQUIRED ---------------------------------------------------------------

# Signing key for login tokens. Generate your own; never reuse a sample value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# docker compose refuses to start while this is empty.
AUTH_JWT_SECRET=

# OpenRouter API key (https://openrouter.ai/keys). Used for embeddings, ingestion
# and answers. The stack starts without it, but search and ask cannot work.
OPENROUTER_API_KEY=

# --- Required by compose, safe to keep as-is --------------------------------

# Qdrant collection that the api and worker read and write. Created on first ingest.
VECTOR_COLLECTION=knowledge__serving

# Durable workflow state. These paths live on the shared `workflowdata` volume.
WORKFLOW_DRAFT_DB=/app/.workflow/draft.sqlite3
WORKFLOW_RUNS_DB=/app/.workflow/runs.sqlite3
WORKFLOW_APPROVALS_DB=/app/.workflow/approvals.sqlite3
WORKFLOW_CHECKPOINT_DB=/app/.workflow/checkpoint.sqlite3

# --- Optional ----------------------------------------------------------------

# Host ports. Change them only if the default is already in use.
WEB_PORT=3001
API_PORT=8000

# Browser origin allowed to call the API directly. The web app proxies /api, so
# this only matters if you call the API from another origin.
CORS_ORIGINS=http://localhost:3001

# Set to true only when the web app is served over HTTPS.
COOKIE_SECURE=false

# Embedding model pin. The code pins it; the containers do not read this file for it.
# Changing these lines does not change the embedding model.
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSION=3072
EMBEDDING_REVISION=google/gemini-embedding-2

# Answer model (any OpenRouter model id).
# ANSWER_MODEL=nvidia/nemotron-3.5-lightning:free

# Knowledge graph leg: off | rule | llm. Off is the tested default.
# GRAPH_MODE=off

# Connector sync (Sources): sync web, S3 and git sources in the background.
# Off by default. The api applies the connector migrations on start.
# SYNC_WORKER_ENABLED=true
#
# Comma-separated roots for local-folder sources. Empty refuses them. The compose
# file mounts no host folder, so add a volume before you set a root.
# CONNECTOR_LOCAL_ROOTS=
#
# Operator approval for S3 sources, a JSON object keyed by workspace UUID. Set the
# same value on the api and the worker. "{}" approves nothing.
# CONNECTOR_S3_SOURCES={"<workspace-uuid>":[{"bucket":"external-documents","prefix":"team-a/"}]}
