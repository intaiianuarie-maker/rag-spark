    "type": "exact ElementType value (title|heading|text|list|table|code|...)",
    "text_contains": "case-sensitive substring of DocumentElement.text",
    "page": "exact 1-based page number of DocumentElement.page when present",
    "section_contains": "substring of DocumentElement.section when present (nearest preceding heading)",
    "metadata_contains": "subdict merged into DocumentElement.metadata when present"
  },
